#!/usr/bin/env python3
"""Reject staged blobs over 5,000 estimated tokens (bytes/4)."""
import subprocess
import sys
paths = subprocess.check_output(["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z"]).split(b"\0")
failed = []
for raw in filter(None, paths):
    path = raw.decode()
    size = int(subprocess.check_output(["git", "cat-file", "-s", ":" + path]))
    if size > 20000:
        failed.append(f"{path}: {size} bytes; split by responsibility (limit 20,000)")
if failed:
    print("\n".join(failed), file=sys.stderr)
    sys.exit(1)
